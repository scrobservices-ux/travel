# ---------------------------------------------------------------------------
# Orderly — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain used for tenant subdomains, e.g. acme.orderly.app
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Supabase (Postgres + Auth + Storage, multi-tenant via RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude agents) ---
ANTHROPIC_API_KEY=sk-ant-...
# Default model for agents. See claude docs for current model ids.
ORDERLY_AGENT_MODEL=claude-opus-4-8

# --- Stripe (billing / per-client subscriptions) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price IDs for the three plans (create them in your Stripe dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# --- Connectors ---
# Google OAuth (used by the Gmail + Google Calendar connectors).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/connections/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Bank feed is via an aggregator (e.g. Plaid); add its keys when wiring linking.
# PLAID_CLIENT_ID=
# PLAID_SECRET=

# --- Email sending (outbox dispatch) ---
# Option A: Resend (simplest). Verify your sending domain first.
RESEND_API_KEY=re_...
EMAIL_FROM="Acme Studio <factures@votre-domaine.fr>"
# Option B: a connected Gmail mailbox (gmail.send scope) — no extra config.

# --- Scheduled jobs (Vercel Cron hits /api/cron) ---
# Vercel automatically sends this as a Bearer token on cron invocations.
CRON_SECRET=a-long-random-string
