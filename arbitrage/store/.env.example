# Flipwise Store — copy to `.env` and fill in. Never commit the real .env.

# --- Stripe (leave blank to run in MOCK mode: simulated checkout, no charges) ---
# Get keys at https://dashboard.stripe.com/apikeys  (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Store config ---
# Public base URL of THIS server (used for Stripe success/cancel redirects).
PUBLIC_URL=http://localhost:4242
PORT=4242

# Shared secret the admin agent app uses to sync listed deals into the store.
# Set a long random value and paste the same one into the app's Settings.
ADMIN_TOKEN=changeme-admin-token

# Where the product catalog JSON lives (default: ./data/products.json).
# DATA_FILE=./data/products.json
