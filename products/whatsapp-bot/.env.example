# --- Meta WhatsApp Cloud API ---
# Get these from https://developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=change-me

# --- Bot ---
PORT=3000
# Path to the client's business config
BUSINESS_CONFIG=./config/business.json
# Phone number (international, no +) that receives human-handoff alerts
OWNER_PHONE=237600000000
