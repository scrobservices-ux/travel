PORT=3001
# SQLite database file (created automatically)
DB_PATH=./bookings.db
# Business config
BUSINESS_CONFIG=./config/business.json

# --- WhatsApp confirmations (optional but recommended) ---
# Same Meta Cloud API credentials as the whatsapp-bot product.
# Leave blank to disable WhatsApp notifications.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Owner's number (international, no +) — gets notified of every new booking
OWNER_PHONE=237600000000
