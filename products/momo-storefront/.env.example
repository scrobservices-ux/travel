PORT=3002
DB_PATH=./orders.db
CATALOG=./config/catalog.json
# Public base URL of this storefront (used for Orange Money return/notify URLs)
BASE_URL=https://shop.example.com
# Owner WhatsApp number for order alerts (international, no +). Leave WhatsApp vars
# blank to disable alerts.
OWNER_PHONE=237600000000
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- MTN Mobile Money (Collections) ---
# Sign up at https://momodeveloper.mtn.com, subscribe to the Collections product.
# Sandbox: currency must be EUR and MOMO_TARGET_ENV=sandbox.
# Production (Cameroon): currency XAF, MOMO_TARGET_ENV=mtncameroon, base URL from MTN.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox
MOMO_CURRENCY=EUR

# --- Orange Money (Web Payment, Cameroon) ---
# Sign up at https://developer.orange.com, subscribe to "Orange Money Web Payment CM".
ORANGE_BASE_URL=https://api.orange.com
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
